{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd app && bun install --frozen-lockfile",
  "buildCommand": "cd app && bun run build",
  "outputDirectory": "app/dist/client",
  "cleanUrls": true,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
