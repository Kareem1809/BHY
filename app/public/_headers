# Cloudflare Pages reads this file. Everything under /assets carries a hash or
# a name that only changes when the file does, so it may be cached for a year;
# the page itself must always be revalidated or a deploy would not be seen.
# Every photograph and film already lives under /assets, so one rule covers
# them: a second rule for *.webp only made the header arrive twice.
/assets/*
  Cache-Control: public, max-age=31536000, immutable


/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
